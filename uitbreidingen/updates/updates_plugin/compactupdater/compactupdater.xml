<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="system" method="upgrade">
	<name>plg_system_compactupdater</name>
	<author>CompactWeb</author>
	<creationDate>2026-11</creationDate>
	<copyright>(C) 2026 CompactWeb</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE</license>
	<authorEmail></authorEmail>
	<authorUrl>https://github.com/WoodyF4u/Compact-Updater</authorUrl>
	<version>2.1.0</version>
	<description>PLG_SYSTEM_COMPACTUPDATER_XML_DESCRIPTION</description>
	<namespace path="src">CompactWeb\Plugin\System\Compactupdater</namespace>
	<files>
		<folder plugin="compactupdater">services</folder>
		<folder>src</folder>
		<folder>language</folder>
	</files>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="toestaan"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					label="PLG_SYSTEM_COMPACTUPDATER_FIELD_TOESTAAN_LABEL"
					description="PLG_SYSTEM_COMPACTUPDATER_FIELD_TOESTAAN_DESC"
					default="1"
					filter="integer"
					>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
		</fields>
	</config>
	<updateservers>
		<server type="extension" priority="1" name="Compact Updater">https://raw.githubusercontent.com/WoodyF4u/Compact-Updater/main/updates.xml</server>
	</updateservers>
</extension>
